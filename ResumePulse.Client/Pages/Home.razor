@page "/"
@using ResumePulse.Client.Services
@inject ResumeApiService ApiService

<PageTitle>ResumePulse - AI Resume Analyzer</PageTitle>

<div class="hero-section text-center py-5 mb-4">
    <h1 class="display-4 fw-bold">
        <span>⚡</span> ResumePulse
    </h1>
    <p class="lead">AI-Powered Resume Analyzer — Get instant feedback on your resume</p>
</div>

@if (_result == null && !_isLoading)
{
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h4 class="card-title mb-4">📄 Analyze Your Resume</h4>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Your Email</label>
                        <input type="email" class="form-control" placeholder="you@example.com"
                               @bind="_email" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Job Description</label>
                        <textarea class="form-control" rows="4"
                                  placeholder="Paste the job description here..."
                                  @bind="_jobDescription"></textarea>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Upload Resume (PDF)</label>
                        <InputFile class="form-control" accept=".pdf" OnChange="HandleFileSelected" />
                        @if (_selectedFile != null)
                        {
                            <small class="text-success mt-1 d-block">✅ @_fileName selected</small>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert alert-danger">@_errorMessage</div>
                    }

                    <button class="btn btn-primary btn-lg w-100"
                            @onclick="SubmitResume"
                            disabled="@(_fileBytes == null || string.IsNullOrEmpty(_jobDescription) || string.IsNullOrEmpty(_email))">
                        🚀 Analyze My Resume
                    </button>
                </div>
            </div>
        </div>
    </div>
}
else if (_isLoading)
{
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-body p-5">
                    <h4 class="fw-bold text-center mb-4">⏳ Processing Your Resume</h4>

                    <!-- Step 1 -->
                    <div class="d-flex align-items-start mb-4">
                        <div class="step-icon me-3">
                            @if (_currentStep > 1)
                            {
                                <span>✅</span>
                            }
                            else if (_currentStep == 1)
                            {
                                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            }
                            else
                            {
                                <span>⭕</span>
                            }
                        </div>
                        <div>
                            <div class="fw-semibold @GetStepTextClass(1)">Resume Uploaded</div>
                            <small class="text-muted">Uploading your PDF to secure cloud storage</small>
                        </div>
                    </div>

                    <!-- Step 2 -->
                    <div class="d-flex align-items-start mb-4">
                        <div class="step-icon me-3">
                            @if (_currentStep > 2)
                            {
                                <span>✅</span>
                            }
                            else if (_currentStep == 2)
                            {
                                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            }
                            else
                            {
                                <span>⭕</span>
                            }
                        </div>
                        <div>
                            <div class="fw-semibold @GetStepTextClass(2)">Queued for Analysis</div>
                            <small class="text-muted">Resume sent to processing queue via Azure Service Bus</small>
                        </div>
                    </div>

                    <!-- Step 3 -->
                    <div class="d-flex align-items-start mb-4">
                        <div class="step-icon me-3">
                            @if (_currentStep > 3)
                            {
                                <span>✅</span>
                            }
                            else if (_currentStep == 3)
                            {
                                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            }
                            else
                            {
                                <span>⭕</span>
                            }
                        </div>
                        <div>
                            <div class="fw-semibold @GetStepTextClass(3)">AI Analyzing Resume</div>
                            <small class="text-muted">Gemini AI is comparing your resume against the job description</small>
                        </div>
                    </div>

                    <!-- Step 4 -->
                    <div class="d-flex align-items-start mb-4">
                        <div class="step-icon me-3">
                            @if (_currentStep > 4)
                            {
                                <span>✅</span>
                            }
                            else if (_currentStep == 4)
                            {
                                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            }
                            else
                            {
                                <span>⭕</span>
                            }
                        </div>
                        <div>
                            <div class="fw-semibold @GetStepTextClass(4)">Report Generated</div>
                            <small class="text-muted">Analysis report saved to cloud storage</small>
                        </div>
                    </div>

                    <!-- Step 5 -->
                    <div class="d-flex align-items-start mb-4">
                        <div class="step-icon me-3">
                            @if (_currentStep > 5)
                            {
                                <span>✅</span>
                            }
                            else if (_currentStep == 5)
                            {
                                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            }
                            else
                            {
                                <span>⭕</span>
                            }
                        </div>
                        <div>
                            <div class="fw-semibold @GetStepTextClass(5)">Email Notification Sent</div>
                            <small class="text-muted">Results delivered to @_email</small>
                        </div>
                    </div>

                    <!-- Progress Bar -->
                    <div class="progress mt-4" style="height:8px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary"
                             style="width:@(_progressPercent)%; transition: width 0.5s ease;">
                        </div>
                    </div>
                    <small class="text-muted d-block text-center mt-2">@_loadingMessage</small>
                </div>
            </div>
        </div>
    </div>
}
else if (_result != null)
{
    <div class="row justify-content-center">
        <div class="col-md-9">

            <!-- All Steps Complete Banner -->
            <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
                <span class="fs-4 me-2">🎉</span>
                <div>
                    <strong>Analysis Complete!</strong> All steps completed successfully.
                    Check your email at <strong>@_email</strong> for the full report.
                </div>
            </div>

            <!-- Score Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body text-center p-4">
                    <h2 class="fw-bold text-primary display-3">
                        @_result.OverallScore<small class="fs-4 text-muted">/100</small>
                    </h2>
                    <p class="text-muted mb-2">Overall Match Score</p>
                    <span class="badge fs-6 px-4 py-2 @GetBadgeClass(_result.Recommendation)">
                        @_result.Recommendation
                    </span>
                </div>
            </div>

            <!-- Summary -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">📋 Summary</h5>
                    <p class="text-muted">@_result.ScoreSummary</p>
                </div>
            </div>

            <!-- Skills Row -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <h5 class="fw-bold text-success mb-3">✅ Matched Skills</h5>
                            @foreach (var skill in _result.MatchedSkills)
                            {
                                <span class="badge bg-success me-1 mb-1 px-3 py-2">@skill</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <h5 class="fw-bold text-danger mb-3">❌ Missing Skills</h5>
                            @foreach (var skill in _result.MissingSkills)
                            {
                                <span class="badge bg-danger me-1 mb-1 px-3 py-2">@skill</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <button class="btn btn-outline-primary w-100" @onclick="Reset">
                🔄 Analyze Another Resume
            </button>
        </div>
    </div>
}

@code {
    private IBrowserFile? _selectedFile;
    private string _jobDescription = "";
    private string _email = "";
    private string _errorMessage = "";
    private bool _isLoading = false;
    private string _loadingMessage = "Starting...";
    private int _progressPercent = 0;
    private int _currentStep = 0;
    private AnalysisReport? _result;

    // Store file bytes immediately on selection — avoids Blazor _blazorFilesById null error
    private byte[]? _fileBytes;
    private string _fileName = "";

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _errorMessage = "";

        // Read file into memory immediately while the reference is still valid
        using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        _fileBytes = ms.ToArray();
        _fileName = e.File.Name;
    }

    private async Task SubmitResume()
    {
        if (_fileBytes == null) return;

        _isLoading = true;
        _errorMessage = "";
        await SetStep(1, "Uploading resume to cloud storage...", 10);

        try
        {
            // Use stored bytes instead of re-opening the file
            using var stream = new MemoryStream(_fileBytes);
            var response = await ApiService.UploadResumeAsync(
                stream, _fileName, _jobDescription, _email);

            if (response != null && response.Status == "Queued")
            {
                await SetStep(2, "Resume queued for processing...", 30);
                await Task.Delay(2000);

                await SetStep(3, "Gemini AI is analyzing your resume...", 50);

                var report = await ApiService.PollForReportAsync(response.JobId);

                if (report != null)
                {
                    await SetStep(4, "Report generated successfully!", 75);
                    await Task.Delay(1500);

                    await SetStep(5, "Sending email notification...", 90);
                    await Task.Delay(2000);

                    _progressPercent = 100;
                    _currentStep = 6;
                    _loadingMessage = "All done!";
                    StateHasChanged();

                    await Task.Delay(500);
                    _result = report;
                }
                else
                {
                    _errorMessage = "Analysis timed out. Please check your email for results.";
                }
            }
            else
            {
                _errorMessage = "Upload failed. Please make sure the API is running.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SetStep(int step, string message, int progress)
    {
        _currentStep = step;
        _loadingMessage = message;
        _progressPercent = progress;
        StateHasChanged();
        await Task.Delay(500);
    }

    private string GetStepIconClass(int step) => _currentStep >= step ? "text-success" : "text-muted";

    private string GetStepTextClass(int step) => _currentStep > step
        ? "text-success"
        : _currentStep == step
            ? "text-primary"
            : "text-muted";

    private string GetBadgeClass(string recommendation) => recommendation switch
    {
        "Strong Match" => "bg-success",
        "Good Match" => "bg-primary",
        "Partial Match" => "bg-warning text-dark",
        _ => "bg-danger"
    };

    private void Reset()
    {
        _result = null;
        _selectedFile = null;
        _fileBytes = null;
        _fileName = "";
        _jobDescription = "";
        _email = "";
        _errorMessage = "";
        _progressPercent = 0;
        _currentStep = 0;
    }
}
